# The Vercel CLI does NOT honour .gitignore — it uploads everything not
# listed here. That is how a gitignored config.js (with a live Billplz key
# in its header comment) reached the public site: array-form rewrites run
# AFTER the filesystem lookup, so an uploaded config.js shadowed the
# /api/config.js function entirely.
#
# Keep this in sync with .gitignore. Anything server-side or machine-local
# stays out of the static bundle.

# Per-deployment config — must come from api/config.js + env vars instead.
# Leading slash is load-bearing: gitignore-style patterns match at any depth,
# so a bare "config.js" would also exclude api/config.js and delete the
# very function that is meant to serve it.
/config.js
/config.local.js

# Secrets
.env
.env.*
.env.local

# Archived reference layers + local state — never part of the site
/archive/
bin/
pb_data/
pb_migrations/

# Backend sources deploy separately (Supabase CLI / api/ functions) and are
# not browser assets. `src/` is the superseded PocketBase adapter layer; no
# runtime file references it.
/supabase/
/src/
/scripts/
.dev.vars*

# Local tooling, repo metadata and machine-specific agent state. `.qoder/`
# is gitignored but the CLI uploads the working tree, so it must be listed
# here or settings.local.json becomes a public URL.
/.qoder/
/.wrignore
/deploy.sh
/worktree
/opencode.json
/skills-lock.json
/wrangler.jsonc
/prod-ca-2021.crt
/config.example.js

# Repo / tooling / docs — never part of the static site
.git
.github
.vscode/
.idea/
vercel/
worktrees/
AGMX/
patches/
tools/
node_modules/
*.md
Dockerfile
.dockerignore
fly.toml
*.pdf
*.xlsx
__pycache__/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

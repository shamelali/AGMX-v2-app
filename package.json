{
  "name": "agmx",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "test": "AGMX_SKIP_NET=1 bash tools/check.sh",
    "check": "bash tools/check.sh",
    "check:phase1-contract": "node tools/check_phase1_contract.mjs",
    "check:commercial-requirements": "node tools/check_commercial_requirements.mjs",
    "check:founding100-program": "node tools/check_founding100_program.mjs",
    "test:intake:worker": "node --test workers/public-intake/test/worker.test.mjs",
    "test:intake:proxy": "node --test tools/test_intake_proxy.mjs",
    "test:intake:frontend": "node --test tools/test_intake_frontend.mjs",
    "test:intake:edge": "node tools/test_intake_edge.mjs",
    "test:intake": "node --test workers/public-intake/test/worker.test.mjs tools/test_intake_proxy.mjs tools/test_intake_frontend.mjs && node tools/test_intake_edge.mjs",
    "check:schema": "python3 tools/build_schema_bundle.py --check",
    "schema:build": "python3 tools/build_schema_bundle.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "google-auth-library": "^11.3.4",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "clean-css": "^5.3.3",
    "sharp": "^0.35.5",
    "terser": "^5.51.2"
  }
}

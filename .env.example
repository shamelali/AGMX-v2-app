# ============================================================
# AGMX — Environment variables
# ============================================================
# Copy to .env.local for local dev, or set in your platform dashboard.
# Never commit real values.

# ------------------------------------------------------------
# Client-safe (reached by the browser via /api/config.js or
# Supabase client). RLS enforces access; these are not secrets.
# ------------------------------------------------------------

# Supabase (project URL + publishable key are client-safe by design)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon key — still accepted as a fallback by /api/config.js
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM provider selector: "openai" or "nvidia"
NEXT_PUBLIC_LLM_PROVIDER=openai

# Model names only — the API keys stay server-side.
NEXT_PUBLIC_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
NEXT_PUBLIC_OPENAI_CHAT_MODEL=gpt-4o-mini

NEXT_PUBLIC_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NEXT_PUBLIC_NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_DIMS=1024

# Canonical app URL (used for payment redirects / absolute links)
NEXT_PUBLIC_APP_URL=https://www.agmx.my

# Feature flags. UNSET means OFF — each one is opt-IN.
#
# These used to be opt-OUT (unset meant ON). No deployment ever set them, so
# production served demoMode:true, and api.js only binds the Supabase adapter
# when demoMode is false: every quote, invoice and "payment" on the live site
# went to the visitor's localStorage while the page printed a paid receipt.
#
# A non-demo deployment MUST set the Supabase URL and key above; with those
# present, mode:"supabase" is published automatically and nothing else is
# needed. Set NEXT_PUBLIC_DEMO_MODE=true only when you deliberately want the
# browser-local demo, and expect writes to stay in that browser.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_KNOWLEDGE_RAG=true    # opt-in only — the RAG room is published
                                    # when a provider key below exists too
# NEXT_PUBLIC_REALTIME=true         # requires wss://*.supabase.co in the CSP
# NEXT_PUBLIC_PAYMENTS_MODE=        # blank = derive from gateway keys below;
                                    # "bank_transfer" narrows the checkout

# ------------------------------------------------------------
# Server-side secrets — do NOT put these in .env.example or any
# client-facing file. They live where the code that needs them runs:
#   Vercel Functions / Edge Functions: SUPABASE_SECRET_KEY, BILLPLZ_*,
#     HITPAY_*, NVIDIA_NIM_API_KEY, OPENAI_API_KEY, ...
# ------------------------------------------------------------

# Supabase secret key (server-side only; used by /api/health and admin jobs)
SUPABASE_SECRET_KEY=

# Billplz (use the sandbox base URL while testing)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_CALLBACK_URL=https://www.agmx.my/api/billplz/callback
BILLPLZ_API_BASE_URL=https://www.billplz.com/api

# HitPay
HITPAY_API_KEY=
HITPAY_SALT=

# GraphRAG / NVIDIA (server-side; Supabase Edge Functions + Vercel Functions).
# The retrieval code reads NVIDIA_NIM_API_KEY, or its alias NGC_API_KEY — not
# NVIDIA_API_KEY, which no code path ever looked for.
LLM_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=
NGC_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_EMBEDDING_DIMS=1024
# Vector storage is Supabase Postgres with pgvector (schema_final.sql).
OPENAI_API_KEY=

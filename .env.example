# AGMX — client-side runtime config (served by api/config.js)
# Copy to .env.local for Vercel, or set these in the Vercel project dashboard.
# Everything here is PUBLIC: the values reach the browser via /api/config.js.
# Never put an API key, salt or HMAC secret in this file — see the bottom note.

# Supabase (project URL + anon key are client-safe by design; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM provider selector: "openai" or "nvidia"
NEXT_PUBLIC_LLM_PROVIDER=openai

# Model names only — the API keys stay server-side in the Edge Functions.
NEXT_PUBLIC_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
NEXT_PUBLIC_OPENAI_CHAT_MODEL=gpt-4o-mini

NEXT_PUBLIC_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NEXT_PUBLIC_NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_DIMS=1024

# Canonical app URL (used for payment redirects / absolute links)
NEXT_PUBLIC_APP_URL=https://agmx-v2-app.vercel.app

# Optional — legacy PocketBase realtime backend
NEXT_PUBLIC_POCKETBASE_URL=

# Feature flags. UNSET means ON — that is what every deployment has always
# served, so the default is preserved deliberately rather than flipped. Set to
# the literal "false" to switch one off. (These used to be computed as an
# always-true expression in api/config.js, so they could not be disabled at
# all; tools/check.sh pass 14 runs the handler and keeps that from returning.)
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_KNOWLEDGE_RAG=false
# NEXT_PUBLIC_REALTIME=false

# Server-side secrets do NOT belong in this file and are not read by
# api/config.js. They live where the code that needs them runs:
#   Supabase Edge Functions -> supabase secrets set   (OPENAI_API_KEY,
#     NVIDIA_NIM_API_KEY, BILLPLZ_API_KEY, HITPAY_API_KEY, HITPAY_SALT, ...)
#   PocketBase JSVM hooks   -> Fly.io env / pb_hooks  (BILLPLZ_*, HITPAY_*)

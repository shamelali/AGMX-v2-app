# ============================================================
# AGMX — Environment variables
# ============================================================
# Copy to .env.local for local dev, or set in your platform dashboard.
# Never commit real values.

# ------------------------------------------------------------
# Client-safe (reached by the browser via /api/config.js or
# Supabase client). RLS enforces access; these are not secrets.
# ------------------------------------------------------------

# Supabase (project URL + anon key are client-safe by design)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM provider selector: "openai" or "nvidia"
NEXT_PUBLIC_LLM_PROVIDER=openai

# Model names only — the API keys stay server-side.
NEXT_PUBLIC_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
NEXT_PUBLIC_OPENAI_CHAT_MODEL=gpt-4o-mini

NEXT_PUBLIC_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NEXT_PUBLIC_NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NEXT_PUBLIC_NVIDIA_NIM_EMBEDDING_DIMS=1024

# Canonical app URL (used for payment redirects / absolute links)
NEXT_PUBLIC_APP_URL=https://agmx-v2-app.vercel.app

# Optional — legacy PocketBase realtime backend
NEXT_PUBLIC_POCKETBASE_URL=

# Feature flags. UNSET means ON — that is what every deployment has always
# served, so the default is preserved deliberately. Set to the literal
# "false" to switch one off.
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_KNOWLEDGE_RAG=false
# NEXT_PUBLIC_REALTIME=false

# ------------------------------------------------------------
# Server-side secrets — do NOT put these in .env.example or any
# client-facing file. They live where the code that needs them runs:
#   Vercel Functions / Edge Functions: DATABASE_URL, BILLPLZ_*,
#     HITPAY_*, NVIDIA_API_KEY, OPENAI_API_KEY, ...
#   PocketBase JSVM hooks: BILLPLZ_*, HITPAY_* (Fly.io env)
# ------------------------------------------------------------

# Neon Postgres (production transactional store — server-side only)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/agmx?sslmode=require

# Billplz (use the sandbox base URL while testing)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_CALLBACK_URL=https://agmx-v2-app.vercel.app/api/billplz/callback
BILLPLZ_API_BASE_URL=https://www.billplz.com/api

# HitPay
HITPAY_API_KEY=
HITPAY_SALT=

# GraphRAG / NVIDIA (server/worker configuration — keep all values server-side)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CONCIERGE_MODEL=meta/llama-3.2-11b-vision-instruct
# Vector storage is Neon Postgres with the pgvector extension. The embedding
# model is fixed to baai/bge-m3 (1024 dimensions) by the migration.
NVIDIA_EMBEDDING_MODEL=baai/bge-m3

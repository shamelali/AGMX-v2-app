# AGMX — local variables for `wrangler pages dev` (copy to .dev.vars)
#
# Pages Functions under functions/ read these values locally. Never commit
# .dev.vars — .gitignore keeps it out, and .wrignore keeps the real file out
# of any upload. The isolated public-intake Worker has its own template at
# workers/public-intake/.dev.vars.example.

# Client-safe runtime configuration
NEXT_PUBLIC_APP_URL=http://localhost:8788
NEXT_PUBLIC_PUBLIC_INTAKE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only same-origin proxy configuration. HTTPS is required; use an
# HTTPS local tunnel when exercising the complete proxy → Worker path.
INTAKE_WORKER_URL=https://your-worker.example.com/api/intake
INTAKE_PROXY_SECRET=
